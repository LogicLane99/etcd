# ============================================================
# Agentgateway
# ============================================================

# Your existing agentgateway endpoint.
#
# Example local port-forward:
#
# AGENTGATEWAY_BASE_URL=http://localhost:3000
#
# Or your existing externally reachable gateway:
#
# AGENTGATEWAY_BASE_URL=https://agentgateway.example.com

AGENTGATEWAY_BASE_URL=http://localhost:3000


# ============================================================
# LLM
# ============================================================

# IMPORTANT:
#
# This is NOT an OpenAI API key.
#
# If your agentgateway does not require client authentication,
# use any placeholder value.
#
# agentgateway documentation notes that the OpenAI SDK requires
# an api_key value even when the gateway itself does not require it.

AGENTGATEWAY_API_KEY=not-needed


# This is the model identifier sent to agentgateway.
#
# With agentgateway's wildcard model routing, the gateway can
# use this identifier to select the configured GPT model.
#
# Change this to a model name that your existing gateway accepts.

HARNESS_MODEL=gpt-4o-mini


# ============================================================
# A2A agents
# ============================================================

KYVERNO_AGENT_URL=${AGENTGATEWAY_BASE_URL}/kyverno

FLUX_AGENT_URL=${AGENTGATEWAY_BASE_URL}/flux

CERT_MANAGER_AGENT_URL=${AGENTGATEWAY_BASE_URL}/cert-manager

EXTERNAL_DNS_AGENT_URL=${AGENTGATEWAY_BASE_URL}/external-dns


# ============================================================
# Harness
# ============================================================

HARNESS_NAME=kubernetes-platform-harness
